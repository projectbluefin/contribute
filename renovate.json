{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "gitIgnoredAuthors": [
    "267480593+mergeraptor[bot]@users.noreply.github.com",
    "295290144+bluefin-ghost-arc[bot]@users.noreply.github.com"
  ],
  "customManagers": [
    {
      "description": "Track OMP release version in the contributor image Containerfile; the post-upgrade task supplies verified per-architecture digests.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)image/contribute/Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=can1357/oh-my-pi\\nARG OMP_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "can1357/oh-my-pi",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "Track GitHub CLI release version in the contributor image Containerfile; the post-upgrade task supplies verified per-architecture digests.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)image/contribute/Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=cli/cli\\nARG GH_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "cli/cli",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "Track Node.js releases in the contributor image Containerfile; the post-upgrade task supplies verified per-architecture digests.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)image/contribute/Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=node-version depName=node\\nARG NODE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "description": "Track tmux static build releases in the contributor image Containerfile; the post-upgrade task supplies verified per-architecture digests.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)image/contribute/Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=tmux/tmux-builds\\nARG TMUX_VERSION=(?<currentValue>[0-9]+\\.[0-9]+[a-z]?)"
      ],
      "depNameTemplate": "tmux/tmux-builds",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "description": "Track requirements-ci.lock package versions; the post-upgrade task regenerates sha256 hashes from PyPI metadata.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)requirements-ci\\.lock$/"
      ],
      "matchStrings": [
        "(?<depName>[a-zA-Z0-9._-]+)==(?<currentValue>[0-9][a-zA-Z0-9._!*+-]*)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Immutable-ref housekeeping automerges by default. Other code-changing updates require review under the supply-chain gate unless a later dependency-specific rule opts into validated automerge; the OMP rule below is that explicit exception. Pull-request automerge and squash are stated because branch protection rejects branch-mode automerge.",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": true
    },
    {
      "description": "Image runtime pins are never rate-limited. Renovate creates a branch before it creates a PR, and the stock config:recommended prHourlyLimit queues PR creation behind whatever else is pending. This repository receives digest updates every day, so that queue never drains: renovate/omp-runtime sat current (Renovate pushed each new OMP release to it) and never once got a PR, leaving the shipped image five releases behind while the tracking itself looked healthy. These four pins ARE the image supply chain — they must not wait behind an action digest.",
      "matchDepNames": [
        "can1357/oh-my-pi",
        "cli/cli",
        "node",
        "tmux/tmux-builds"
      ],
      "prConcurrentLimit": 0,
      "prHourlyLimit": 0
    },
    {
      "description": "Track every stable OMP GitHub release, refresh verified binary digests, and merge after repository checks so the image publisher runs from main.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "can1357/oh-my-pi"
      ],
      "groupName": "OMP runtime",
      "rangeStrategy": "replace",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": true,
      "postUpgradeTasks": {
        "commands": [
          "node scripts/update-omp-pins.mjs"
        ],
        "fileFilters": [
          "image/contribute/Containerfile"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Keep FSDK base and builder image digests in Containerfiles current",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "ghcr.io/projectbluefin/lab-runner",
        "ghcr.io/projectbluefin/base"
      ],
      "pinDigests": true
    },
    {
      "description": "Track GitHub CLI releases and refresh verified binary digests.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "cli/cli"
      ],
      "groupName": "GitHub CLI runtime",
      "rangeStrategy": "replace",
      "postUpgradeTasks": {
        "commands": [
          "node scripts/update-gh-pins.mjs"
        ],
        "fileFilters": [
          "image/contribute/Containerfile"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Track Node.js releases and refresh verified binary digests.",
      "matchDatasources": [
        "node-version"
      ],
      "matchPackageNames": [
        "node"
      ],
      "groupName": "Node.js runtime",
      "rangeStrategy": "replace",
      "postUpgradeTasks": {
        "commands": [
          "node scripts/update-node-pins.mjs"
        ],
        "fileFilters": [
          "image/contribute/Containerfile"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Track tmux static builds and refresh verified binary digests.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "tmux/tmux-builds"
      ],
      "groupName": "tmux runtime",
      "rangeStrategy": "replace",
      "postUpgradeTasks": {
        "commands": [
          "node scripts/update-tmux-pins.mjs"
        ],
        "fileFilters": [
          "image/contribute/Containerfile"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Regenerate requirements-ci.lock sha256 hashes when managed PyPI package versions change.",
      "matchDatasources": [
        "pypi"
      ],
      "postUpgradeTasks": {
        "commands": [
          "node scripts/update-requirements-ci-hashes.mjs"
        ],
        "fileFilters": [
          "requirements-ci.lock"
        ],
        "executionMode": "branch"
      }
    }
  ]
}
