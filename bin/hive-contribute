#!/usr/bin/env bash
# hive-contribute — run one Hive contributor worker in an isolated container.
#
# This appliance is Hive's contributor runtime (contributor-agent.sh +
# contributor-relay.js, tracked from upstream's branch and never pinned),
# packaged with OMP so a contributor needs no toolchain of their own. Hive owns
# task selection, assignment, and completion; OMP owns model and effort; this
# launcher owns exactly three things: the isolation boundary, the credentials
# that cross it, and the one configuration file below.
#
#   hive-contribute            launch the worker (foreground; Ctrl-C stops it)
#   hive-contribute doctor     read-only preflight; starts no agent
#   hive-contribute setup      register this machine with a hive
#   hive-contribute config     print the resolved configuration
#
# CONFIGURATION — ONE FILE:
#   ${XDG_CONFIG_HOME:-~/.config}/hive-contribute.yml
# It carries everything site-specific: which hive to join, which credential
# file Hive wrote, which image to run, and which agent backend. Nothing
# site-specific is compiled into this script.
# Point HIVE_CONTRIBUTE_CONFIG at another file to run a second identity.
set -euo pipefail

fail() {
  printf 'hive-contribute: %s\n' "$1" >&2
  exit 1
}
note() { printf 'hive-contribute: %s\n' "$1" >&2; }

# ── Configuration ────────────────────────────────────────────────────────────
# A flat `key: value` subset of YAML, parsed here rather than with a YAML
# dependency the distroless image would have to carry: the file has nine keys
# and an appliance that needs a parser to read its own config is not simpler
# than one that does not.
CONFIG_PATH="${HIVE_CONTRIBUTE_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/hive-contribute.yml}"

# Defaults for a first run. The hub deliberately has none: joining the wrong
# hive silently is worse than refusing to start, and `setup` fills it in.
DEFAULT_REGISTRATION="${HOME}/.config/hive/contributor.env"
DEFAULT_IMAGE="ghcr.io/projectbluefin/contribute:stable"
DEFAULT_BACKEND="omp"
# Upstream's contributor workload envelope (Justfile: contributor_memory_limit_gib
# and contributor_cpu_limit), kept identical so a contributor lends the same
# share of their machine here as they would running Hive's own recipe. `none`
# or `0` removes the ceiling.
DEFAULT_MEMORY="4g"
DEFAULT_CPUS="2"
# Hive's own tracking branch. Nothing here pins a commit: the appliance runs
# upstream's current contributor runtime, and registration is performed by that
# same branch's contribute-setup, so both follow one line. They are not the
# same commit: setup clones v4 live, while the image carries the SHA resolved
# when it was last built, so they can differ. The daily rebuild is meant to
# bound that gap, not to guarantee it.
HIVE_REF="v4"

config_value() {
  # One key, first match, comments and surrounding quotes removed, leading ~
  # expanded. Absent key prints nothing.
  local key="$1" raw
  [[ -f "$CONFIG_PATH" ]] || return 0
  raw="$(sed -nE "s/^[[:space:]]*${key}[[:space:]]*:[[:space:]]*(.*)$/\1/p" "$CONFIG_PATH" | head -1)"
  raw="${raw%%#*}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  raw="${raw#\"}"
  raw="${raw%\"}"
  raw="${raw#\'}"
  raw="${raw%\'}"
  # shellcheck disable=SC2088 # matching a literal tilde written in the config
  # file, not expanding one: the value is data, not a shell word.
  [[ "$raw" == "~/"* ]] && raw="${HOME}/${raw:2}"
  printf '%s\n' "$raw"
}

write_default_config() {
  local hub="${1:-}"
  mkdir -p "$(dirname "$CONFIG_PATH")"
  cat >"$CONFIG_PATH" <<EOF
# hive-contribute — the whole appliance configuration.
#
# hub          the hive this machine contributes to (wss://<host>/contribute)
# registration Hive's own credential file, written by its contribute-setup
# image        contributor runtime image to run
# backend      agent CLI Hive drives inside the container
# memory       RAM ceiling for the worker (also the microVM's size); none = no limit
# cpus         CPU ceiling for the worker (also the microVM's vCPUs); none = no limit
# llmman       OpenAI-compatible base URL of YOUR llmman daemon; empty = cloud only
# llmman_token file holding that daemon's API key (0600); empty = unauthenticated
# llmman_model model the daemon must serve; 'doctor' checks it is loaded there
hub: ${hub}
registration: ${DEFAULT_REGISTRATION}
image: ${DEFAULT_IMAGE}
backend: ${DEFAULT_BACKEND}
memory: ${DEFAULT_MEMORY}
cpus: ${DEFAULT_CPUS}
llmman:
llmman_token:
llmman_model:
EOF
  chmod 600 "$CONFIG_PATH"
}

load_config() {
  if [[ ! -f "$CONFIG_PATH" ]]; then
    # Seed from an existing Hive registration when there is one: the hub is the
    # single value this launcher cannot invent, and Hive already wrote it.
    local seeded=""
    [[ -f "$DEFAULT_REGISTRATION" ]] &&
      seeded="$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?HIVE_HUB[[:space:]]*=[[:space:]]*"?([^"]*)"?[[:space:]]*$/\2/p' "$DEFAULT_REGISTRATION" | head -1)"
    write_default_config "$seeded"
    note "wrote ${CONFIG_PATH}"
  fi
  HUB="$(config_value hub)"
  REGISTRATION="$(config_value registration)"
  IMAGE="$(config_value image)"
  BACKEND="$(config_value backend)"
  MEMORY="$(config_value memory)"
  CPUS="$(config_value cpus)"
  LLMMAN="$(config_value llmman)"
  LLMMAN_TOKEN="$(config_value llmman_token)"
  LLMMAN_MODEL="$(config_value llmman_model)"
  REGISTRATION="${REGISTRATION:-$DEFAULT_REGISTRATION}"
  IMAGE="${IMAGE:-$DEFAULT_IMAGE}"
  BACKEND="${BACKEND:-$DEFAULT_BACKEND}"
  MEMORY="${MEMORY:-$DEFAULT_MEMORY}"
  CPUS="${CPUS:-$DEFAULT_CPUS}"
}

require_hub() {
  [[ -n "${HUB:-}" ]] ||
    fail "no hub in ${CONFIG_PATH}. Run 'hive-contribute setup', or set 'hub: wss://<host>/contribute'."
  [[ "$HUB" =~ ^wss://[^[:space:]/]+(/[^[:space:]]*)?$ ]] ||
    fail "hub '${HUB}' in ${CONFIG_PATH} is not a wss:// URL."
}

instance_slug() {
  # One state directory and one image volume per hive, derived from the hub so
  # two configurations never share a home volume.
  local digest
  digest="$(printf '%s' "$HUB" | sha256sum | cut -c1-8)"
  printf 'hive-%s\n' "$digest"
}

# ── Host preflight ───────────────────────────────────────────────────────────
KVM_FAILURE=""
PODMAN_FAILURE=""

host_is_linux() {
  if [[ -n "${HIVE_CONTRIBUTE_TEST_OS:-}" ]]; then
    [[ "$HIVE_CONTRIBUTE_TEST_OS" == "Linux" ]]
    return
  fi
  if command -v uname &>/dev/null; then
    [[ "$(uname -s)" == "Linux" ]]
    return
  fi
  [[ "${OSTYPE:-}" == linux* ]]
}

podman_is_local() {
  # A remote Podman engine would resolve bind mounts on the far side, where
  # this machine's credential file does not exist.
  local connections
  connections="$(podman system connection list --format '{{.URI}}\t{{.Default}}' 2>/dev/null || true)"
  [[ -z "$connections" ]] && return 0
  local uri is_default
  while IFS=$'\t' read -r uri is_default; do
    [[ "$is_default" == true ]] || continue
    [[ "$uri" == unix://* || -z "$uri" ]] && return 0
    return 1
  done <<<"$connections"
  return 0
}

podman_ready() {
  host_is_linux || {
    PODMAN_FAILURE="this appliance requires a Linux host; on macOS use Lima, on Windows use WSL2"
    return 1
  }
  command -v podman &>/dev/null || { PODMAN_FAILURE="Podman is unavailable"; return 1; }
  podman info &>/dev/null || { PODMAN_FAILURE="Podman is not reachable"; return 1; }
  podman_is_local || { PODMAN_FAILURE="Podman targets a remote engine"; return 1; }
  return 0
}

kvm_runtime_ready() {
  local device="${HIVE_CONTRIBUTE_TEST_KVM_DEVICE:-/dev/kvm}"
  podman_ready || { KVM_FAILURE="$PODMAN_FAILURE"; return 1; }
  # Ask Podman whether `--runtime=krun` resolves, rather than looking for a
  # `krun` executable on PATH. The launch uses `podman run --runtime=krun`, and
  # Podman resolves that NAME through the runtimes map in containers.conf,
  # where a host may register krun against a differently named binary such as
  # /usr/bin/crun-krun. An unregistered name fails here without starting a container:
  #   $ podman --runtime=krun info
  #   Error: default OCI runtime "krun" not found: invalid argument
  podman --runtime=krun info &>/dev/null ||
    { KVM_FAILURE="Podman cannot resolve the krun OCI runtime"; return 1; }
  [[ -r "$device" && -w "$device" ]] || { KVM_FAILURE="${device} is not readable and writable"; return 1; }
  return 0
}

github_auth_ready() {
  command -v gh &>/dev/null && gh auth status --hostname github.com &>/dev/null
}

resolve_gh_token() {
  # By value, never by mounting ~/.config/gh: the container gets one credential
  # for one host, and no view of any other account or enterprise login.
  GH_TOKEN_VALUE="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  GH_TOKEN_SOURCE="environment"
  if [[ -z "$GH_TOKEN_VALUE" ]] && command -v gh &>/dev/null; then
    GH_TOKEN_SOURCE="gh auth token"
    GH_TOKEN_VALUE="$(gh auth token --hostname github.com 2>/dev/null || true)"
  fi
  [[ -n "$GH_TOKEN_VALUE" ]] || GH_TOKEN_SOURCE=""
  return 0
}

report_gh_token() {
  local scopes
  echo "✓ GitHub identity passed to the agent as GH_TOKEN (from ${GH_TOKEN_SOURCE}; value not shown)."
  scopes="$(gh auth status --hostname github.com 2>&1 | sed -nE "s/.*[Tt]oken scopes:[[:space:]]*(.+)/\1/p" | head -1 || true)"
  [[ -n "$scopes" ]] && echo "  The agent can do anything this token can: ${scopes}"
  return 0
}

report_missing_gh_token() {
  note "no GitHub token found; every assigned task dies on arrival."
  note "Fix it with: gh auth login --web --hostname github.com --scopes repo,read:org,workflow"
}

# ── Hive registration ────────────────────────────────────────────────────────
registration_value() {
  local key="$1"
  [[ -f "$REGISTRATION" ]] || return 0
  sed -nE "s/^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=[[:space:]]*\"?([^\"]*)\"?[[:space:]]*$/\2/p" "$REGISTRATION" | head -1
}

hive_checkout() {
  # Registration is upstream's business: run ITS setup, from ITS current
  # branch, rather than reimplementing a credential protocol against a frozen
  # copy. The image tracks the same branch, so setup and runtime follow one
  # release line — bounded by the daily rebuild, not identical by construction.
  local dir="${XDG_STATE_HOME:-${HOME}/.local/state}/hive-contribute/hive-src"
  if [[ ! -d "$dir/.git" ]]; then
    mkdir -p "$dir"
    git init --quiet "$dir"
    git -C "$dir" remote add origin "https://github.com/hivecommons/hive"
  fi
  git -C "$dir" fetch --depth 1 origin "$HIVE_REF" >/dev/null 2>&1 ||
    fail "cannot fetch hivecommons/hive ${HIVE_REF}."
  git -C "$dir" checkout --detach -f FETCH_HEAD >/dev/null 2>&1
  printf '%s\n' "$dir"
}

run_setup() {
  local src tmp shim
  # Upstream's contribute-setup is a just recipe that shells out to gh, git,
  # curl and jq, and its omp preflight runs bin/omp-backend.js with the host's
  # node. Name every missing one here rather than let the recipe die mid-way
  # with a bare "command not found" after it has already talked to the hub.
  for cmd in just gh git curl jq node; do
    command -v "$cmd" &>/dev/null || fail "'${cmd}' is required to register with a hive."
  done
  github_auth_ready || fail "gh is not authenticated. Run: gh auth login --web --hostname github.com --scopes repo,read:org"
  src="$(hive_checkout)"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/hive-contribute-setup.XXXXXX")"
  shim=""
  if ! command -v "$BACKEND" &>/dev/null; then
    # Upstream's registration preflight probes the HOST for the agent CLI and
    # aborts when it is absent. On this appliance that is the normal case and
    # not a fault: the agent runs inside ${IMAGE}, which is the whole point of
    # packaging it. Answer the probe with the image that will actually run the
    # work, so registration is not blocked by a toolchain nobody needs.
    shim="$(mktemp -d "${TMPDIR:-/tmp}/hive-contribute-shim.XXXXXX")"
    cat >"${shim}/${BACKEND}" <<EOF
#!/usr/bin/env bash
echo "${BACKEND} (packaged in ${IMAGE}; this host has no agent CLI by design)"
EOF
    chmod 0755 "${shim}/${BACKEND}"
  fi
  # HIVE_SKIP_VERSION_CHECK is upstream's own documented opt-out; this checkout
  # is a detached head of the branch it compares against, exactly the case it
  # documents.
  #
  # HIVE_HUB is how upstream's recipe learns which hive to register with; left
  # unset it falls back to an interactive hive picker and registers against
  # whatever gets chosen, which for a configured `hub:` is a silent mismatch
  # (the config is then rewritten to match the credential below). A run that
  # has a hub says so; one that does not gets upstream's picker on purpose.
  # Through `env`, because an assignment that comes out of an expansion is an
  # argument, not a prefix — bash decides which words are assignments before
  # it expands anything.
  PATH="${shim:+${shim}:}${PATH}" env HIVE_SKIP_VERSION_CHECK=true ${HUB:+"HIVE_HUB=${HUB}"} just \
    --working-directory "$src" --justfile "$src/Justfile" \
    config_dir="$tmp" contribute-setup "$BACKEND" || {
    rm -rf "$tmp" ${shim:+"$shim"}
    fail "upstream contribute-setup did not complete; nothing was registered."
  }
  [[ -z "$shim" ]] || rm -rf "$shim"
  [[ -f "$tmp/contributor.env" ]] || { rm -rf "$tmp"; fail "contribute-setup produced no contributor.env."; }
  mkdir -p "$(dirname "$REGISTRATION")"
  install -m 600 "$tmp/contributor.env" "$REGISTRATION"
  rm -rf "$tmp"
  local hub
  hub="$(registration_value HIVE_HUB)"
  if [[ -n "$hub" && "$hub" != "$HUB" ]]; then
    # The hub is the one value that must agree between config and credential.
    sed -i -E "s|^[[:space:]]*hub[[:space:]]*:.*$|hub: ${hub}|" "$CONFIG_PATH"
    note "hub recorded in ${CONFIG_PATH}: ${hub}"
  fi
  echo "✓ registered: ${REGISTRATION} (0600)"
}
# ── Image ────────────────────────────────────────────────────────────────────
image_is_local_path() { [[ -f "$IMAGE" ]]; }

ensure_image() {
  # A moving tag must be refreshed before launch or the worker silently runs
  # last month's runtime against this month's hub.
  case "$IMAGE" in
  *@sha256:*) podman image exists "$IMAGE" &>/dev/null && return 0 ;;
  *) podman pull --quiet "$IMAGE" >/dev/null 2>&1 && return 0 ;;
  esac
  podman image exists "$IMAGE" &>/dev/null ||
    fail "cannot resolve image ${IMAGE}. Set 'image:' in ${CONFIG_PATH}, or build it with 'just contribute-build'."
  note "using the locally cached ${IMAGE}; the registry copy could not be checked."
}

# ── Provenance ───────────────────────────────────────────────────────────────
# publish-contribute.yml pushes a Sigstore build-provenance attestation for
# every published digest (actions/attest), and this launcher is the consumer
# where it matters: it hands the image the operator's GitHub token and every
# provider key it can find. Verify the provenance of what is about to run.
#
# Scope: only ghcr.io/projectbluefin/* refs. A localhost build, a *.sif file,
# and an operator's explicit off-registry image are that operator's own trust
# decision and are skipped. The check targets the DIGEST actually pulled, so a
# tag moved between pull and launch cannot swap the bits under a green check.
#
# A host without gh warns and runs unverified, so minimal and offline hosts
# keep working; a host with gh fails closed — an isolation appliance that
# shrugs off a failed provenance check has no boundary left to offer.
# HIVE_CONTRIBUTE_NO_VERIFY=1 is the operational escape hatch for a Sigstore
# or GitHub API outage, and it says out loud that it is one.
verify_image_provenance() {
  local ref="$1"
  [[ "$ref" == ghcr.io/projectbluefin/* ]] || return 0
  if [[ "${HIVE_CONTRIBUTE_NO_VERIFY:-0}" == 1 ]]; then
    note "HIVE_CONTRIBUTE_NO_VERIFY=1: launching ${ref} WITHOUT provenance verification."
    return 0
  fi
  if ! command -v gh &>/dev/null; then
    note "gh is unavailable; launching ${ref} WITHOUT provenance verification."
    return 0
  fi
  # The attesting repository is the image path itself: ghcr.io/<owner>/<name>
  # is published by github.com/<owner>/<name> for every image this guard
  # covers.
  local repo signer output
  repo="${ref%%@*}"
  repo="${repo%:*}"
  signer="${repo#ghcr.io/}"
  if ! output="$(gh attestation verify "oci://${ref}" --repo "$signer" 2>&1)"; then
    note "$output"
    fail "build-provenance verification failed for ${ref}; refusing to launch. If Sigstore or the GitHub API is down and you accept the risk yourself, relaunch with HIVE_CONTRIBUTE_NO_VERIFY=1."
  fi
  note "build provenance verified: ${ref}"
}

pulled_digest_ref() {
  # The digest Podman actually stored for $IMAGE, as <repo>@sha256:<hex>, or
  # nothing when Podman cannot say — the caller then verifies the tag ref
  # rather than failing a launch over introspection.
  local digest repo
  digest="$(podman image inspect --format '{{.Digest}}' "$IMAGE" 2>/dev/null || true)"
  case "$digest" in
  sha256:[0-9a-f]*)
    repo="${IMAGE%%@*}"
    repo="${repo%:*}"
    printf '%s@%s\n' "$repo" "$digest"
    ;;
  esac
}

# ── Local inference (llmman) ─────────────────────────────────────────────────
# Bluefin's Agent Mode runs llmman bound to 127.0.0.1. A container worker
# cannot reach that without an explicit route out: by default rootless Podman
# isolates the host's loopback interface from the container's network
# namespace. slirp4netns:allow_host_loopback=true provides that route and
# makes the host's loopback interface reachable at 10.0.2.2.
#
# NOTE: allow_host_loopback=true exposes the host's entire loopback interface
# (127.0.0.1) to the worker at 10.0.2.2, not only the llmman port. Operators
# should be aware of any other services bound to 127.0.0.1.
SLIRP_HOST_LOOPBACK="10.0.2.2"
# An OpenAI-compatible client sends no request without an API key, and the
# ordinary loopback llmman daemon accepts any value. Naming the placeholder
# here is what keeps the operator's REAL OpenAI key out of a local daemon's
# logs: on this path OPENAI_API_KEY is always the appliance's value.
LLMMAN_UNAUTHENTICATED_KEY="llmman-local"

LLMMAN_FAILURE=""
LLMMAN_NETWORK_ARG=""
LLMMAN_CONTAINER_URL=""
LLMMAN_TRANSPORT=""
LLMMAN_TOKEN_VALUE=""

local_inference_selected() { [[ -n "${LLMMAN:-}" ]]; }

resolve_llmman_endpoint() {
  # Split the configured base URL and decide which transport reaches it, so
  # both `run` and `doctor` answer from one place.
  LLMMAN_FAILURE=""
  LLMMAN_NETWORK_ARG=""
  LLMMAN_CONTAINER_URL=""
  LLMMAN_TRANSPORT=""
  local url="$LLMMAN"
  [[ "$url" =~ ^https?://[^[:space:]/]+(/[^[:space:]]*)?$ ]] || {
    LLMMAN_FAILURE="llmman '${url}' in ${CONFIG_PATH} is not an http:// or https:// base URL"
    return 1
  }
  local scheme="${url%%://*}" rest="${url#*://}"
  local authority="${rest%%/*}" path=""
  [[ "$rest" == */* ]] && path="/${rest#*/}"
  local host="$authority" port=""
  if [[ "$authority" == \[*\]* ]]; then
    # A bracketed IPv6 literal: the colons inside the brackets are the address.
    host="${authority%%\]*}]"
    port="${authority#"$host"}"
  elif [[ "$authority" == *:* ]]; then
    host="${authority%%:*}"
    port=":${authority##*:}"
  fi
  local is_loopback=0
  if [[ "$host" == "localhost" || "$host" == "[::1]" ]]; then
    is_loopback=1
  elif [[ "$host" =~ ^127\.([0-9]{1,3}\.){2}[0-9]{1,3}$ ]]; then
    is_loopback=1
  fi
  if ((is_loopback)); then
    LLMMAN_NETWORK_ARG="slirp4netns:allow_host_loopback=true"
    LLMMAN_CONTAINER_URL="${scheme}://${SLIRP_HOST_LOOPBACK}${port}${path}"
    LLMMAN_TRANSPORT="slirp4netns host loopback (${SLIRP_HOST_LOOPBACK})"
  else
    # An endpoint the operator reached over the network already: the container's
    # ordinary network reaches it too, and rewriting it would break it.
    LLMMAN_CONTAINER_URL="$url"
    LLMMAN_TRANSPORT="the container's ordinary network"
  fi
  return 0
}

resolve_llmman_token() {
  # From a file, never from the config file itself and never from argv: the
  # config records WHERE the key lives so the key is not copied into a second
  # place with its own permissions to get wrong.
  LLMMAN_FAILURE=""
  LLMMAN_TOKEN_VALUE=""
  [[ -n "${LLMMAN_TOKEN:-}" ]] || return 0
  [[ -e "$LLMMAN_TOKEN" ]] || {
    LLMMAN_FAILURE="llmman_token ${LLMMAN_TOKEN} does not exist"
    return 1
  }
  [[ -r "$LLMMAN_TOKEN" ]] || {
    LLMMAN_FAILURE="llmman_token ${LLMMAN_TOKEN} is not readable"
    return 1
  }
  LLMMAN_TOKEN_VALUE="$(head -1 "$LLMMAN_TOKEN" | tr -d '\r\n')"
  [[ -n "$LLMMAN_TOKEN_VALUE" ]] || {
    LLMMAN_FAILURE="llmman_token ${LLMMAN_TOKEN} is empty"
    return 1
  }
  return 0
}

llmman_probe() {
  # A read-only GET of the OpenAI-compatible model list, used by `doctor` only:
  # reachability, authentication, and which models are loaded are one answer
  # from one request. Prints the HTTP status on the first line and the body
  # after it; returns non-zero when the request itself never completed.
  #
  # The bearer token rides a `--config -` stanza on stdin rather than a `-H`
  # argument, because a header on the command line is a credential in `ps`.
  #
  # It probes the HOST's URL, not the container's: doctor runs here, and the
  # question is whether this machine's daemon is up before a worker starts.
  local url="${LLMMAN%/}/models"
  local stdin_config="" body status
  [[ -n "$LLMMAN_TOKEN_VALUE" ]] &&
    stdin_config="$(printf 'header = "Authorization: Bearer %s"\n' "$LLMMAN_TOKEN_VALUE")"
  body="$(printf '%s\n' "$stdin_config" |
    curl --silent --show-error --max-time 5 --config - --write-out '\n%{http_code}' "$url" 2>/dev/null)" ||
    return 1
  status="${body##*$'\n'}"
  printf '%s\n%s' "$status" "${body%$'\n'*}"
  return 0
}

llmman_served_models() {
  # The `id` fields of an OpenAI-compatible /models response, without a JSON
  # dependency: `doctor` runs on a host that needs no toolchain, and `jq` is a
  # registration prerequisite rather than a launch one.
  grep -oE '"id"[[:space:]]*:[[:space:]]*"[^"]+"' |
    sed -E 's/.*"([^"]+)"$/\1/' | sort -u
}

# ── Launch ───────────────────────────────────────────────────────────────────

# Named, never valued, on the Podman path: the runtime resolves `--env NAME`
# from this process, so a secret never appears in argv. The list is upstream's
# contributor set (Justfile's add_provider_env) narrowed to what OMP actually
# reads, plus the Bedrock trio.
FORWARDED_CREDENTIALS=(
  GH_TOKEN GITHUB_TOKEN COPILOT_GITHUB_TOKEN GITHUB_COPILOT_TOKEN
  ANTHROPIC_API_KEY ANTHROPIC_OAUTH_TOKEN
  OPENAI_API_KEY OPENROUTER_API_KEY
  GEMINI_API_KEY GOOGLE_API_KEY
  AWS_BEARER_TOKEN_BEDROCK AWS_REGION AWS_DEFAULT_REGION
)

launch_once() {
  local slug
  slug="$(instance_slug)"

  podman_ready || fail "${PODMAN_FAILURE}."
  if local_inference_selected; then
    # Refuse before pulling an image or touching a credential: a malformed
    # endpoint is a typo in the one file the operator edits, and a worker that
    # started anyway would run the assigned task on a cloud provider while its
    # operator believed they were donating local inference.
    resolve_llmman_endpoint || fail "${LLMMAN_FAILURE}. Run 'hive-contribute doctor'."
    resolve_llmman_token || fail "${LLMMAN_FAILURE}. Run 'hive-contribute doctor'."
    # The appliance's value, always — an operator who opted into their own
    # daemon does not also ship their cloud OpenAI key to it.
    export OPENAI_BASE_URL="$LLMMAN_CONTAINER_URL"
    export OPENAI_API_KEY="${LLMMAN_TOKEN_VALUE:-$LLMMAN_UNAUTHENTICATED_KEY}"
    [[ -n "${LLMMAN_MODEL:-}" ]] && export LLMMAN_MODEL="$LLMMAN_MODEL"
  fi
  ensure_image
  local verify_ref
  verify_ref="$(pulled_digest_ref)"
  verify_image_provenance "${verify_ref:-$IMAGE}"
  local name
  name="hive-contribute-${slug}-$(date +%s)-$$"

  local runtime_args=()
  if kvm_runtime_ready; then
    runtime_args+=(--runtime=krun)
    echo "✓ starting isolated KVM worker ${name}. Choose model and effort in OMP."
  else
    note "${KVM_FAILURE}; running container worker without KVM boundary."
    echo "✓ starting container worker ${name}. Choose model and effort in OMP."
  fi
  if local_inference_selected; then
    echo "✓ local inference: ${LLMMAN_CONTAINER_URL} over ${LLMMAN_TRANSPORT}"
    if [[ -n "$LLMMAN_TOKEN_VALUE" ]]; then
      echo "  authenticated from ${LLMMAN_TOKEN} (value not shown)"
    else
      echo "  unauthenticated: no llmman_token is configured"
    fi
    if [[ -n "${LLMMAN_MODEL:-}" ]]; then
      echo "  model: ${LLMMAN_MODEL} (the OpenAI cloud slot is repurposed; other configured providers remain)"
    else
      echo "  model: not specified (the OpenAI cloud slot is repurposed; other configured providers remain)"
    fi
  fi

  local args=(
    podman run "${runtime_args[@]}" --rm --interactive --tty
    --name "$name"
    --userns "keep-id:uid=65532,gid=65532"
    --volume "hive-contribute-${slug}:/home/hive:rw"
    --volume "${REGISTRATION}:/home/hive/.config/hive/contributor.env:ro,z"
    --env "AGENT_BACKEND=${BACKEND}"
    --env "HIVE_CONTAINER_NAME=${name}"
    --env HIVE_CONTAINER_RUNTIME=podman
    --env "TERM=${TERM:-xterm-256color}"
    --env "COLORTERM=${COLORTERM:-truecolor}"
  )
  # The workload ceiling. --memory-swap pinned to --memory is what stops a
  # contributor spilling another limit's worth into host swap; under krun the
  # pair sizes the microVM itself rather than a cgroup.
  [[ "$MEMORY" != none && "$MEMORY" != 0 ]] &&
    args+=(--memory "$MEMORY" --memory-swap "$MEMORY")
  [[ "$CPUS" != none && "$CPUS" != 0 ]] && args+=(--cpus "$CPUS")
  # Opting into a loopback endpoint uses slirp4netns:allow_host_loopback=true,
  # which exposes the host loopback interface (127.0.0.1) to the worker at
  # 10.0.2.2. A routable network endpoint needs no custom network mode.
  if [[ -n "$LLMMAN_NETWORK_ARG" ]]; then
    args+=(--network "$LLMMAN_NETWORK_ARG")
  fi
  # By value, because it is an address and not a secret — and a recorded one is
  # how an operator proves afterwards which endpoint the worker actually used.
  # The key beside it still crosses by name, with the rest of the credentials.
  if local_inference_selected; then
    args+=(--env "OPENAI_BASE_URL=${LLMMAN_CONTAINER_URL}")
    if [[ -n "${LLMMAN_MODEL:-}" ]]; then
      args+=(--env "LLMMAN_MODEL=${LLMMAN_MODEL}")
    fi
  fi
  # One GitHub account has one contributor identity per hub, so two relays
  # under the same account would collide on a single task slot. HIVE_SESSION
  # is the relay's own label for telling them apart, and an explicit EMPTY
  # value is its documented opt-out — so forward whenever the variable is
  # SET, empty or not, and leave it absent otherwise.
  [[ -v HIVE_SESSION ]] && args+=(--env "HIVE_SESSION=${HIVE_SESSION}")
  local credential
  for credential in "${FORWARDED_CREDENTIALS[@]}"; do
    [[ -n "${!credential:-}" ]] && args+=(--env "$credential")
  done
  args+=("$IMAGE")
  "${args[@]}"
  return $?
}

run_worker() {
  host_is_linux || fail "this appliance requires a Linux host; on macOS use Lima, on Windows use WSL2."
  load_config
  # Registration comes first, and the hub check follows it. A fresh machine has
  # neither, and demanding the hub up front turned the one command this
  # appliance exists for into an error telling the operator to run a second
  # one. Upstream's setup is what discovers the hive and writes the credential;
  # it records the hub it registered against, so re-reading the config here is
  # what lets `hive-contribute` — with no arguments, on a machine with nothing
  # configured — end up running the worker.
  if [[ ! -f "$REGISTRATION" ]]; then
    note "no Hive registration at ${REGISTRATION}."
    run_setup
    load_config
  fi
  require_hub
  echo "✓ hive: ${HUB}"
  resolve_gh_token
  if [[ -n "${GH_TOKEN_VALUE:-}" ]]; then
    export GH_TOKEN="$GH_TOKEN_VALUE"
    report_gh_token
  else
    report_missing_gh_token
  fi

  launch_once
}

run_doctor() {
  load_config
  local pass=0 fail_count=0
  echo "=== Configuration ==="
  echo "  ✓ ${CONFIG_PATH}"
  if [[ -n "${HUB:-}" ]]; then
    echo "  ✓ hive: ${HUB}"
    pass=$((pass + 1))
  else
    echo "  ✗ no hub configured; run 'hive-contribute setup'"
    fail_count=$((fail_count + 1))
  fi
  echo ""

  echo "=== Isolation runtime ==="
  KVM_FAILURE=""
  if ! host_is_linux; then
    echo "  ✗ this appliance requires a Linux host; on macOS use Lima, on Windows use WSL2"
    fail_count=$((fail_count + 1))
  elif kvm_runtime_ready; then
    echo "  ✓ Podman krun KVM runtime ready"
    pass=$((pass + 1))
  elif podman_ready; then
    echo "  ! ${KVM_FAILURE}; Podman container runtime ready"
    pass=$((pass + 1))
  else
    echo "  ✗ ${PODMAN_FAILURE}"
    fail_count=$((fail_count + 1))
  fi
  echo ""

  echo "=== GitHub ==="
  if github_auth_ready; then
    echo "  ✓ gh is authenticated against github.com"
    pass=$((pass + 1))
  else
    echo "  ✗ gh is not authenticated against github.com"
    fail_count=$((fail_count + 1))
  fi
  resolve_gh_token
  if [[ -n "${GH_TOKEN_VALUE:-}" ]]; then
    echo "  ✓ a GitHub token is available for the agent (from ${GH_TOKEN_SOURCE}; not shown)"
    pass=$((pass + 1))
  else
    echo "  ✗ no GitHub token is available; every assigned task would die on arrival"
    fail_count=$((fail_count + 1))
  fi
  unset GH_TOKEN_VALUE
  echo ""

  echo "=== Registration ==="
  if [[ -f "$REGISTRATION" ]]; then
    echo "  ✓ ${REGISTRATION} exists"
    pass=$((pass + 1))
    # Existing is not the same as accepted: hubs rotate registration tokens, and
    # only the hub can say whether this one still works. Hive's relay reports
    # that when it connects; repairing it is upstream's `contribute-move`.
    echo "    the hub decides whether it is still accepted when the relay connects"
  else
    echo "  ✗ ${REGISTRATION} is missing; the first run registers through upstream Hive"
    fail_count=$((fail_count + 1))
    # Registration is upstream's recipe running on THIS host, so it needs a
    # host toolchain the container cannot supply. Say which piece is missing
    # here rather than at the end of a half-finished registration.
    local missing=()
    local cmd
    for cmd in just gh git curl jq node; do
      command -v "$cmd" &>/dev/null || missing+=("$cmd")
    done
    if [[ "${#missing[@]}" -eq 0 ]]; then
      echo "    ✓ upstream's setup can run here (just, gh, git, curl, jq, node)"
    else
      echo "    ✗ upstream's setup needs these on this host: ${missing[*]}"
    fi
  fi
  echo ""

  echo "=== Image ==="
  if image_is_local_path; then
    echo "  ✓ ${IMAGE} (local)"
    pass=$((pass + 1))
  elif host_is_linux && command -v podman &>/dev/null && podman image exists "$IMAGE" &>/dev/null; then
    echo "  ✓ ${IMAGE} is present locally"
    pass=$((pass + 1))
  else
    echo "  - ${IMAGE} is not cached; it is pulled at launch"
  fi
  echo ""

  # The whole point of this section: answer reachability, authentication, and
  # model availability HERE, before a worker starts, rather than letting the
  # operator discover a dead endpoint as a failed assignment.
  echo "=== Local inference ==="
  if ! local_inference_selected; then
    echo "  - not selected; the worker uses whichever cloud provider you configured"
    echo "    to donate local inference, set 'llmman: http://127.0.0.1:17434/v1' in ${CONFIG_PATH}"
  elif ! resolve_llmman_endpoint; then
    echo "  ✗ ${LLMMAN_FAILURE}"
    fail_count=$((fail_count + 1))
  else
    echo "  ✓ ${LLMMAN} (the container reaches it as ${LLMMAN_CONTAINER_URL})"
    pass=$((pass + 1))
    local slirp=""
    if [[ -z "$LLMMAN_NETWORK_ARG" ]]; then
      echo "  ✓ transport: ${LLMMAN_TRANSPORT}"
      pass=$((pass + 1))
    else
      # Podman is the authority on whether it can find slirp4netns: it resolves
      # the helper through its own configuration, not only through PATH. A
      # query that FAILS is a different answer from one that returns nothing —
      # the first says this Podman cannot be asked, the second says the helper
      # is absent — and only the second is a reason to refuse.
      if slirp="$(podman info --format '{{.Host.Slirp4NetNS.Executable}}' 2>/dev/null)"; then
        if [[ -n "$slirp" && "$slirp" != "<no value>" ]]; then
          echo "  ✓ transport: ${LLMMAN_TRANSPORT}"
          pass=$((pass + 1))
        else
          echo "  ✗ ${LLMMAN_TRANSPORT} needs slirp4netns, which Podman does not find"
          echo "    install slirp4netns, or point 'llmman' at an address this host reaches over the network"
          fail_count=$((fail_count + 1))
        fi
      else
        echo "  ! Podman could not report slirp4netns; ${LLMMAN_TRANSPORT} is unverified"
      fi
    fi

    local token_mode=""
    if ! resolve_llmman_token; then
      echo "  ✗ ${LLMMAN_FAILURE}"
      fail_count=$((fail_count + 1))
    elif [[ -n "$LLMMAN_TOKEN_VALUE" ]]; then
      echo "  ✓ key read from ${LLMMAN_TOKEN} (value not shown)"
      pass=$((pass + 1))
      token_mode="$(stat -c '%a' "$LLMMAN_TOKEN" 2>/dev/null || true)"
      [[ -n "$token_mode" && "${token_mode: -2}" != "00" ]] &&
        echo "    ! ${LLMMAN_TOKEN} is mode ${token_mode}; 'chmod 600' keeps it to this account"
    else
      echo "  - no llmman_token configured; the endpoint is contacted unauthenticated"
    fi

    local response="" status="" body="" models=""
    if ! command -v curl &>/dev/null; then
      echo "  ✗ curl is required to verify the endpoint before a worker starts"
      fail_count=$((fail_count + 1))
    elif ! response="$(llmman_probe)"; then
      echo "  ✗ ${LLMMAN%/}/models did not answer"
      echo "    start your llmman service, then run this command again"
      fail_count=$((fail_count + 1))
    else
      status="${response%%$'\n'*}"
      # A status with nothing after it is a body-less answer, not a body that
      # happens to equal the status.
      [[ "$response" == *$'\n'* ]] && body="${response#*$'\n'}"
      case "$status" in
      200)
        echo "  ✓ the endpoint answered and accepted this identity"
        pass=$((pass + 1))
        models="$(printf '%s' "$body" | llmman_served_models)"
        if [[ -z "${LLMMAN_MODEL:-}" ]]; then
          echo "  - no llmman_model configured; it serves: ${models//$'\n'/, }"
        elif grep -qxF "$LLMMAN_MODEL" <<<"$models"; then
          echo "  ✓ ${LLMMAN_MODEL} is loaded there"
          pass=$((pass + 1))
        else
          echo "  ✗ ${LLMMAN_MODEL} is not loaded; it serves: ${models//$'\n'/, }"
          fail_count=$((fail_count + 1))
        fi
        ;;
      401 | 403)
        echo "  ✗ the endpoint refused this identity (HTTP ${status})"
        echo "    point 'llmman_token' at the key your daemon expects"
        fail_count=$((fail_count + 1))
        ;;
      *)
        echo "  ✗ the endpoint answered HTTP ${status:-<none>}, which is not an OpenAI-compatible model list"
        fail_count=$((fail_count + 1))
        ;;
      esac
    fi
    unset LLMMAN_TOKEN_VALUE
  fi
  echo ""

  echo "${pass} checks passed, ${fail_count} failed."
  [[ "$fail_count" -eq 0 ]] || exit 1
}

run_config() {
  load_config
  echo "config:       ${CONFIG_PATH}"
  echo "hub:          ${HUB:-<unset>}"
  echo "registration: ${REGISTRATION}"
  echo "image:        ${IMAGE}"
  echo "backend:      ${BACKEND}"
  echo "memory:       ${MEMORY}"
  echo "cpus:         ${CPUS}"
  echo "llmman:       ${LLMMAN:-<unset: cloud providers only>}"
  echo "llmman_token: ${LLMMAN_TOKEN:-<unset>}"
  echo "llmman_model: ${LLMMAN_MODEL:-<unset>}"
  echo "hive ref:     ${HIVE_REF} (tracked, never pinned)"
}

case "${1:-run}" in
run) run_worker ;;
doctor) run_doctor ;;
setup)
  host_is_linux || fail "this appliance requires a Linux host; on macOS use Lima, on Windows use WSL2."
  load_config
  run_setup
  ;;
config) run_config ;;
-h | --help | help)
  sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
  ;;
*) fail "unknown command '${1}'. Usage: hive-contribute {run|doctor|setup|config}" ;;
esac
