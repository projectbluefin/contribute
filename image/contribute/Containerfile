# Hive Contribute: an isolated interactive Hive + OMP worker.
ARG FSDK_BASE_IMAGE=ghcr.io/projectbluefin/base:26.08@sha256:ec37df46272f099dad56af35ef2838494d3f33836438788335f472b3b06ac869
ARG FSDK_BUILDER_IMAGE=ghcr.io/projectbluefin/lab-runner:26.08@sha256:8adaee237abc17f31f7838c8ab5375f9ab073052bf0ba8d65f221def4caffb5e
# Hive's contributor runtime is never pinned in this repository: the appliance
# IS upstream Hive's runtime, and a stored copy is a fork with extra steps.
#
# HIVE_COMMIT is resolved by the CALLER — `just contribute-build`, the publish
# workflow, and the validate workflow each read Hive's tracking branch
# (refs/heads/v4) and pass the SHA in. That is what makes "always the latest
# Hive" true: the value is part of the layer's cache key, so the moment
# upstream moves, this RUN re-executes. Resolving it inside the layer instead
# would leave a constant cache key and a build that silently reuses whatever it
# fetched first.
#
# It is REQUIRED, with no branch fallback. A build that resolved the branch
# internally could still stamp /usr/share/hive/contribute/HIVE_COMMIT, but the
# final stage cannot see a value computed inside the builder — so the image
# would ship a populated commit file beside an empty provenance label. Failing
# fast beats shipping an image that cannot say what is inside it.
ARG HIVE_COMMIT=
# renovate: datasource=github-releases depName=can1357/oh-my-pi
ARG OMP_VERSION=18.3.1
ARG OMP_X86_64_SHA256=0806df602bf2bb9b202d152204b1bef6450eb6bcbfbf31d66e3767d1bbb3b3a7
ARG OMP_AARCH64_SHA256=95b9e3dc3c2096885be2c9c923bd45bb3bf81d172367db7e7090936729261e2c
# renovate: datasource=node-version depName=node
ARG NODE_VERSION=24.21.0
ARG NODE_X86_64_SHA256=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
ARG NODE_AARCH64_SHA256=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2
# renovate: datasource=github-releases depName=cli/cli
ARG GH_VERSION=2.101.0
ARG GH_X86_64_SHA256=9bca2d1c16825f109907a23307628a2f0698fbf99662b73a5cf0b020293072b8
ARG GH_AARCH64_SHA256=b57e8063f18862647c9d22727c32e9da1b963f8bf9db648fe123a6975695640f
# renovate: datasource=github-releases depName=tmux/tmux-builds
ARG TMUX_VERSION=3.7c
ARG TMUX_X86_64_SHA256=cc56bd1cc873eb6089c615f0496b072385bda8a6d944069f38564a5d49c128aa
ARG TMUX_AARCH64_SHA256=29dcb978da2a4b0cf6790f9e004865dac239a3ba03bbf776dddacce23d03831b
ARG CONTRIBUTE_VERSION=0.0.0
ARG CONTRIBUTE_REVISION=unknown

FROM ${FSDK_BUILDER_IMAGE} AS build
ARG HIVE_COMMIT OMP_VERSION OMP_X86_64_SHA256 OMP_AARCH64_SHA256
ARG NODE_VERSION NODE_X86_64_SHA256 NODE_AARCH64_SHA256
ARG GH_VERSION GH_X86_64_SHA256 GH_AARCH64_SHA256
ARG TMUX_VERSION TMUX_X86_64_SHA256 TMUX_AARCH64_SHA256
ARG CONTRIBUTE_VERSION CONTRIBUTE_REVISION
COPY package.json package-lock.json /src/
COPY --chmod=0755 image/contribute/stage-runtime.sh /usr/local/libexec/stage-runtime
COPY --chmod=0755 scripts/generate-contribute-sbom.py /usr/local/libexec/contribute-sbom
# Hive's `gh` policy layer, byte-for-byte from the same commit as the relay.
# Upstream's contributor image installs bin/gh-wrapper.sh AS `gh`, ahead of the
# real binary, with a root-owned /etc/hive/contributor-mode marker beside it —
# and the wrapper's contributor branch is chosen by that marker's existence,
# never by an environment variable the agent could set. It is what keeps an
# assigned task from running `gh auth` against the operator's credential
# store, from reaching GitHub through a mutating `gh api`, and from using any
# subcommand nobody reviewed; it is also what labels a contributor's PRs
# `contributor/<login>` and `cli/omp`. Shipping the raw binary instead left
# this appliance's agent holding the operator's full-scope token with none of
# that. The real binary keeps upstream's own path, /opt/hive/bin/gh-real,
# which is the wrapper's compiled-in default (REAL_GH), so nothing is patched.
#
# omp-backend.js is deliberately NOT STAGED: it is a HOST-side staging helper
# for `just contribute-hive`, upstream's own contributor image does not carry
# it, and neither contributor-agent.sh nor contributor-relay.js requires it.
# The archive below contains it, as it contains all of Hive; what keeps it out
# of the image is the extraction list, and the contract asserts the image, not
# what crossed the network.
#
# Every Hive file comes out of ONE commit-addressed archive. Per-file fetches
# would be seven requests describing a snapshot instead of the snapshot itself,
# with seven ways to fail; and `bin/lib/` has to arrive as a directory anyway,
# because upstream's image does `COPY bin/lib/` and naming one file inside it
# would silently drop a module upstream added.
# Each downloaded binary is verified against its pinned digest by
# verify_digest, which NAMES the dependency, the pinned version and both
# digests when they disagree. `sha256sum -c --status` was silent by
# construction: a mismatch failed the build with no line of output, so a
# version bumped without its digests — the exact failure this repository's pin
# synchronizers exist to prevent — surfaced only as a 5KB "error building at
# STEP RUN" with nothing in it saying which dependency, or that a digest was
# involved at all.
RUN set -eu; \
    hive_commit="${HIVE_COMMIT}"; \
    case "$hive_commit" in \
      "") echo "HIVE_COMMIT is required: pass --build-arg HIVE_COMMIT=<40-hex sha>. 'just contribute-build' and the workflows resolve Hive's tracking branch and pass it." >&2; exit 1 ;; \
      *[!0-9a-f]*) echo "HIVE_COMMIT is not a commit SHA: ${hive_commit}" >&2; exit 1 ;; \
    esac; \
    case "${#hive_commit}" in 40) : ;; *) echo "HIVE_COMMIT must be a full 40-character SHA: ${hive_commit}" >&2; exit 1 ;; esac; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) omp_asset=omp-linux-x64; omp_sha="$OMP_X86_64_SHA256"; node_arch=x64; node_sha="$NODE_X86_64_SHA256"; gh_arch=amd64; gh_sha="$GH_X86_64_SHA256"; tmux_arch=x86_64; tmux_sha="$TMUX_X86_64_SHA256" ;; \
      aarch64|arm64) omp_asset=omp-linux-arm64; omp_sha="$OMP_AARCH64_SHA256"; node_arch=arm64; node_sha="$NODE_AARCH64_SHA256"; gh_arch=arm64; gh_sha="$GH_AARCH64_SHA256"; tmux_arch=arm64; tmux_sha="$TMUX_AARCH64_SHA256" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    workdir="$(mktemp -d)"; trap 'rm -rf "$workdir"' EXIT; \
    verify_digest() { \
      _want="$2"; _got="$(sha256sum "$3" | cut -d' ' -f1)"; \
      [ "$_got" = "$_want" ] && return 0; \
      echo "$1 $4 digest mismatch: pinned $_want, downloaded $_got" >&2; \
      echo "the pinned digest does not belong to the pinned version — version and both architecture digests must be refreshed together (scripts/update-*-pins.mjs)" >&2; \
      exit 1; \
    }; \
    mkdir -p /out/usr/bin /out/usr/local/bin/lib /out/usr/local/etc/hive /out/usr/lib/hive /out/usr/share/hive/contribute /out/opt/hive/bin /out/etc/hive/restrictions; \
    curl --fail --location --show-error --silent "https://github.com/can1357/oh-my-pi/releases/download/v${OMP_VERSION}/${omp_asset}" -o "$workdir/omp"; \
    verify_digest OMP "$omp_sha" "$workdir/omp" "$OMP_VERSION"; install -m 0755 "$workdir/omp" /out/usr/bin/omp; \
    curl --fail --location --show-error --silent "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -o "$workdir/node.tar.xz"; \
    verify_digest Node "$node_sha" "$workdir/node.tar.xz" "$NODE_VERSION"; tar --no-same-owner -xf "$workdir/node.tar.xz" -C "$workdir"; \
    node_root="$workdir/node-v${NODE_VERSION}-linux-${node_arch}"; \
    curl --fail --location --show-error --silent "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${gh_arch}.tar.gz" -o "$workdir/gh.tar.gz"; \
    verify_digest "GitHub CLI" "$gh_sha" "$workdir/gh.tar.gz" "$GH_VERSION"; tar -xzOf "$workdir/gh.tar.gz" --wildcards --occurrence=1 '*/bin/gh' > "$workdir/gh"; chmod 0755 "$workdir/gh"; \
    curl --fail --location --show-error --silent "https://github.com/tmux/tmux-builds/releases/download/v${TMUX_VERSION}/tmux-${TMUX_VERSION}-linux-${tmux_arch}.tar.gz" -o "$workdir/tmux.tar.gz"; \
    verify_digest tmux "$tmux_sha" "$workdir/tmux.tar.gz" "$TMUX_VERSION"; tar -xzOf "$workdir/tmux.tar.gz" --occurrence=1 tmux > "$workdir/tmux"; chmod 0755 "$workdir/tmux"; \
    PATH="$node_root/bin:$PATH" npm --prefix /src ci --omit=dev --ignore-scripts; \
    cp -a /src/node_modules /out/usr/lib/hive/node_modules; \
    /usr/local/libexec/stage-runtime /out "$node_root/bin/node" "$workdir/gh" "$workdir/tmux" /usr/bin/cmp; \
    mv /out/usr/bin/gh /out/opt/hive/bin/gh-real; \
    curl --fail --location --show-error --silent "https://codeload.github.com/hivecommons/hive/tar.gz/${hive_commit}" -o "$workdir/hive.tar.gz"; \
    mkdir -p "$workdir/hive"; \
    tar -xzf "$workdir/hive.tar.gz" -C "$workdir/hive" --strip-components=1 --wildcards \
      "*/bin/contributor-agent.sh" "*/bin/contributor-relay.js" "*/bin/pi-backend.js" "*/bin/lib/*" \
      "*/bin/gh-wrapper.sh" "*/config/backends.conf" "*/config/restrictions/contributor-default.json"; \
    install -m 0755 "$workdir/hive/bin/contributor-agent.sh" "$workdir/hive/bin/contributor-relay.js" "$workdir/hive/bin/pi-backend.js" /out/usr/local/bin/; \
    cp -a "$workdir/hive/bin/lib/." /out/usr/local/bin/lib/; \
    [ -n "$(ls -A /out/usr/local/bin/lib)" ] || { echo "bin/lib/ staged empty from ${hive_commit}" >&2; exit 1; }; \
    install -m 0755 "$workdir/hive/bin/gh-wrapper.sh" /out/usr/bin/gh; \
    install -m 0644 "$workdir/hive/config/backends.conf" /out/usr/local/etc/hive/backends.conf; \
    install -m 0644 "$workdir/hive/config/restrictions/contributor-default.json" /out/etc/hive/restrictions/contributor-default.json; \
    : > /out/etc/hive/contributor-mode; \
    printf '%s\n' "$hive_commit" > /out/usr/share/hive/contribute/HIVE_COMMIT; \
    /usr/local/libexec/contribute-sbom --out /out/usr/share/hive/contribute/sbom.spdx.json --version "$CONTRIBUTE_VERSION" --revision "$CONTRIBUTE_REVISION" --hive-commit "$hive_commit" --arch "$arch" --omp-version "$OMP_VERSION" --omp-sha256 "$omp_sha" --node-version "$NODE_VERSION" --node-sha256 "$node_sha" --gh-version "$GH_VERSION" --gh-sha256 "$gh_sha" --tmux-version "$TMUX_VERSION" --tmux-sha256 "$tmux_sha" --ws-version "$("$node_root/bin/node" -p "require('/src/node_modules/ws/package.json').version")"; \
    python3 -m json.tool /out/usr/share/hive/contribute/sbom.spdx.json >/dev/null; \
    install -d -m 0755 /out/etc /out/home/hive/.config/hive /out/home/hive/workspace /out/var/run/hive-metrics; \
    printf 'root:x:0:0:root:/root:/usr/bin/bash\nhive:x:65532:65532:Hive:/home/hive:/usr/bin/bash\n' > /out/etc/passwd; \
    printf 'root:x:0:\nhive:x:65532:\n' > /out/etc/group; \
    chown -R 65532:65532 /out/home/hive /out/var/run/hive-metrics; \
    for binary in /out/usr/bin/omp /out/usr/bin/node /out/usr/bin/gh /out/opt/hive/bin/gh-real /out/usr/bin/tmux /out/usr/bin/bash /out/usr/bin/git /out/usr/bin/curl /out/usr/bin/find /out/usr/bin/grep /out/usr/bin/sed /out/usr/bin/cmp /out/usr/bin/python3; do test -x "$binary"; done; \
    test ! -e /out/usr/bin/npm; test ! -e /out/usr/bin/corepack

FROM ${FSDK_BASE_IMAGE}
ARG FSDK_BASE_IMAGE HIVE_COMMIT OMP_VERSION NODE_VERSION GH_VERSION TMUX_VERSION CONTRIBUTE_VERSION CONTRIBUTE_REVISION
COPY --from=build /out /
COPY --chmod=0755 image/contribute/entrypoint.sh /usr/local/bin/hive-contribute
COPY image/tmux.conf /etc/tmux.conf
# Hive owns the `omp` command line inside its tmux session, so the image's own
# OMP settings ride PI_CONFIG_FILES, the documented wrapper seam: it loads as a
# CLI overlay, above user and project settings, without touching Hive's argv.
COPY image/contribute/config.yml /usr/share/hive/contribute/omp-config.yml
# LANG is load-bearing for the attended terminal, not cosmetic. Without a
# UTF-8 locale glibc resolves to C, and tmux then treats its attach client as
# non-UTF-8: box drawing degrades to DEC ACS escapes and every other non-ASCII
# cell — arrows, bullets, the status-line emoji, OMP's own glyphs — is written
# to the terminal as `_`. The base ships C.utf8 and en_US.utf8; C.UTF-8 keeps
# byte-ordered collation and language-neutral formatting for the agent.
ENV HOME=/home/hive \
    XDG_CONFIG_HOME=/home/hive/.config \
    XDG_STATE_HOME=/home/hive/.local/state \
    NODE_PATH=/usr/lib/hive/node_modules \
    PATH=/usr/bin:/bin \
    SHELL=/usr/bin/bash \
    TERM=xterm-256color \
    LANG=C.UTF-8 \
    PI_CONFIG_FILES=/usr/share/hive/contribute/omp-config.yml \
    AGENT_BACKEND=omp
LABEL org.opencontainers.image.title="Hive Contribute" \
      org.opencontainers.image.description="Distroless OMP contributor runtime for Hive-assigned work." \
      org.opencontainers.image.source="https://github.com/projectbluefin/contribute" \
      org.opencontainers.image.revision="${CONTRIBUTE_REVISION}" \
      org.opencontainers.image.version="${CONTRIBUTE_VERSION}" \
      org.opencontainers.image.base.name="${FSDK_BASE_IMAGE}" \
      io.hivecommons.contribute="true" \
      io.hivecommons.contribute.omp.version="${OMP_VERSION}" \
      io.hivecommons.contribute.hive.ref="${HIVE_COMMIT}" \
      io.hivecommons.contribute.node.version="${NODE_VERSION}" \
      io.hivecommons.contribute.gh.version="${GH_VERSION}" \
      io.hivecommons.contribute.tmux.version="${TMUX_VERSION}"
USER 65532:65532
WORKDIR /home/hive/workspace
ENTRYPOINT ["/usr/local/bin/hive-contribute"]
